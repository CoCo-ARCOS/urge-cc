---
/**
 * URGE-CC — the whole site is this one page.
 * All copy lives in ../site.config.ts; edit there, not here.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";
---

<Layout>
  <Header />

  <main id="main">
    <Hero />

    {/* ── Motivation and objectives ─────────────────────────────────────── */}
    <Section
      id="motivation"
      eyebrow="Motivation"
      heading={site.motivation.heading}
      lead={site.motivation.lead}
    >
      {/* Motivation, then objectives — one continuous prose column. */}
      <div class="max-w-3xl" data-reveal>
        {
          site.motivation.body.map((paragraph) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-600 first:mt-0 dark:text-ink-300">
              {paragraph}
            </p>
          ))
        }

        {
          site.motivation.objectivesHeading && (
            <h3 class="mt-12 text-sm font-semibold tracking-wide text-ink-900 uppercase dark:text-white">
              {site.motivation.objectivesHeading}
            </h3>
          )
        }

        {
          site.motivation.objectives.map((objective) => (
            <p class="mt-6 text-lg leading-relaxed text-ink-600 dark:text-ink-300">
              {objective.title && (
                <strong class="font-semibold text-ink-900 dark:text-white">
                  {objective.title}.{" "}
                </strong>
              )}
              {objective.body}
            </p>
          ))
        }
      </div>
    </Section>

    {/* ── Topics ────────────────────────────────────────────────────────── */}
    <Section
      id="topics"
      eyebrow="Call for papers"
      heading={site.topics.heading}
      lead={site.topics.lead}
    >
      <ol class="max-w-4xl divide-y divide-ink-200 border-y border-ink-200 dark:divide-ink-800 dark:border-ink-800">
        {
          site.topics.items.map((topic, i) => (
            <li
              class="group flex gap-5 py-6 sm:gap-7"
              data-reveal
            >
              <span
                class="mt-0.5 shrink-0 font-mono text-sm text-ink-400 tabular-nums transition-colors group-hover:text-urgent-600 dark:group-hover:text-urgent-400"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="text-lg font-semibold text-ink-900 dark:text-white">
                  {topic.title}
                </h3>
                <p class="mt-1.5 leading-relaxed text-ink-600 dark:text-ink-300">
                  {topic.body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </Section>

    {/* ── Important dates ───────────────────────────────────────────────── */}
    <Section
      id="dates"
      eyebrow="Timeline"
      heading={site.dates.heading}
      tinted
    >
      <ol class="border-t border-ink-200 dark:border-ink-800">
        {
          site.dates.items.map((item) => (
            <li
              class:list={[
                "flex flex-col gap-1 border-b py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8",
                item.highlight
                  ? "border-urgent-500/40"
                  : "border-ink-200 dark:border-ink-800",
              ]}
              data-reveal
            >
              <span
                class:list={[
                  "text-lg font-medium",
                  item.highlight
                    ? "text-urgent-600 dark:text-urgent-400"
                    : "text-ink-900 dark:text-white",
                ]}
              >
                {item.label}
              </span>
              <span class="font-mono text-sm tracking-wide whitespace-nowrap text-ink-500 dark:text-ink-400">
                {item.date}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
        {site.dates.note}
      </p>
    </Section>

    {/* ── Submission ────────────────────────────────────────────────────── */}
    <Section
      id="submission"
      eyebrow="Authors"
      heading={site.submission.heading}
      lead={site.submission.lead}
    >
      {/* Manuscript requirements at a glance. */}
      <dl
        class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-200 bg-ink-200 lg:grid-cols-4 dark:border-ink-800 dark:bg-ink-800"
        data-reveal
      >
        {
          site.submission.specs.map((spec) => (
            <div class="bg-white px-5 py-5 dark:bg-ink-950">
              <dt class="font-mono text-[0.7rem] tracking-[0.12em] text-ink-400 uppercase">
                {spec.label}
              </dt>
              <dd class="mt-2 font-semibold text-ink-900 dark:text-white">
                {spec.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-14 grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
        <div data-reveal>
          <h3 class="text-lg font-semibold text-ink-900 dark:text-white">
            {site.submission.anonymity.heading}
          </h3>
          <p class="mt-4 leading-relaxed text-ink-600 dark:text-ink-300">
            {site.submission.anonymity.body}
          </p>

          <ol class="mt-6 space-y-4">
            {
              site.submission.anonymity.rules.map((rule, i) => (
                <li class="flex gap-4">
                  <span
                    class="mt-0.5 shrink-0 font-mono text-sm text-ink-400 tabular-nums"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="leading-relaxed text-ink-700 dark:text-ink-300">
                    {rule}
                  </span>
                </li>
              ))
            }
          </ol>

          {
            site.submission.anonymity.warning && (
              <p class="mt-8 flex gap-3.5 rounded-xl border border-urgent-500/30 bg-urgent-50 px-5 py-4 text-sm leading-relaxed font-medium text-urgent-700 dark:bg-urgent-500/10 dark:text-urgent-300">
                <svg
                  class="mt-0.5 h-5 w-5 shrink-0"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path
                    d="M10 6.5v4.2M10 13.6v.2"
                    stroke-linecap="round"
                  />
                  <circle cx="10" cy="10" r="7.2" />
                </svg>
                {site.submission.anonymity.warning}
              </p>
            )
          }
        </div>

        <div
          class="self-start rounded-2xl border border-ink-200 bg-ink-50 p-7 dark:border-ink-800 dark:bg-ink-900"
          data-reveal
        >
          {
            site.submission.button.disabled ? (
              <>
                <span class="block w-full cursor-not-allowed rounded-full bg-ink-200 px-6 py-3 text-center text-sm font-semibold text-ink-500 dark:bg-ink-800 dark:text-ink-400">
                  {site.submission.button.label}
                </span>
                <p class="mt-4 text-center text-sm text-ink-500 dark:text-ink-400">
                  {site.submission.disabledNote}
                </p>
              </>
            ) : (
              <a
                href={site.submission.button.href}
                class="block w-full rounded-full bg-urgent-500 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-urgent-600"
              >
                {site.submission.button.label}
              </a>
            )
          }

          <p
            class="mt-6 border-t border-ink-200 pt-6 text-sm leading-relaxed text-ink-600 dark:border-ink-800 dark:text-ink-300"
          >
            Questions about scope or fit? Email us at{" "}
            <a
              href={`mailto:${site.contact.email}`}
              class="font-medium text-urgent-600 underline underline-offset-4 dark:text-urgent-400"
            >
              {site.contact.email}
            </a>.
          </p>
        </div>
      </div>
    </Section>

    {/* ── Committee ─────────────────────────────────────────────────────── */}
    <Section
      id="committee"
      eyebrow="People"
      heading={site.committee.heading}
      lead={site.committee.lead}
      tinted
    >
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          site.committee.organisers.map((person) => (
            <li
              class="rounded-2xl border border-ink-200 bg-white p-7 dark:border-ink-800 dark:bg-ink-950"
              data-reveal
            >
              <p class="font-mono text-xs tracking-[0.12em] text-urgent-600 uppercase dark:text-urgent-400">
                {person.role}
              </p>
              <h3 class="mt-3 text-lg font-semibold text-ink-900 dark:text-white">
                {person.url && person.url !== "#" ? (
                  <a
                    href={person.url}
                    class="underline decoration-ink-300 underline-offset-4 hover:decoration-urgent-500"
                  >
                    {person.name}
                  </a>
                ) : (
                  person.name
                )}
              </h3>
              <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">
                {person.affiliation}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="mt-14" data-reveal>
        <h3
          class="text-sm font-semibold tracking-wide text-ink-900 uppercase dark:text-white"
        >
          {site.committee.pcHeading}
        </h3>
        <ul
          class="mt-5 grid gap-x-10 gap-y-2.5 text-ink-600 sm:grid-cols-2 lg:grid-cols-3 dark:text-ink-300"
        >
          {
            site.committee.programme.map((member) => (
              <li class="border-l-2 border-ink-200 pl-3.5 dark:border-ink-800">
                {member}
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    {/* ── Venue ─────────────────────────────────────────────────────────── */}
    <Section id="venue" eyebrow="Venue" heading={site.venue.heading}>
      <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
        <div data-reveal>
          {
            site.venue.body.map((paragraph) => (
              <p class="mt-5 text-lg leading-relaxed text-ink-600 first:mt-0 dark:text-ink-300">
                {paragraph}
              </p>
            ))
          }
          <a
            href={site.conference.url}
            class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-urgent-600 dark:text-urgent-400"
          >
            {site.conference.name} conference site
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <dl
          class="divide-y divide-ink-200 rounded-2xl border border-ink-200 dark:divide-ink-800 dark:border-ink-800"
          data-reveal
        >
          {
            site.venue.details.map((detail) => (
              <div class="flex items-baseline justify-between gap-6 px-6 py-4">
                <dt class="font-mono text-xs tracking-[0.12em] text-ink-400 uppercase">
                  {detail.label}
                </dt>
                <dd class="text-right font-medium text-ink-900 dark:text-white">
                  {detail.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </Section>

  </main>

  <Footer />
</Layout>

<script>
  /* Reveal sections as they scroll into view. */
  const items = document.querySelectorAll("[data-reveal]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduced || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          obs.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    items.forEach((el) => observer.observe(el));
  }
</script>
