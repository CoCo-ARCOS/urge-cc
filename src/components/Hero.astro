---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../site.config";
import SeoulSkyline from "./SeoulSkyline.astro";

const { hero } = site;
const usePhoto = hero.background === "photo";

/*
 * Hero photos live in src/assets/hero/ so Astro can resize them and emit WebP
 * at build time — a 7 MB original ships as a few hundred KB. The glob is eager
 * so the lookup by filename resolves at build, not in the browser.
 */
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/hero/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const photoName = hero.photo.replace(/^\/?(src\/assets\/hero\/)?/, "");
const heroImage = heroImages[`/src/assets/hero/${photoName}`]?.default;

/* Fallback for a photo kept in /public — needs the deploy base prefix. */
const publicPhoto = `${import.meta.env.BASE_URL}/${hero.photo}`.replace(
  /\/{2,}/g,
  "/",
);

/*
 * h-auto keeps the skyline at its natural 1600×520 proportions on wide screens.
 * min-h takes over on narrow ones, where the SVG's `slice` fitting crops in to
 * Namsan and N Seoul Tower instead of shrinking the city to a sliver.
 */
const skylineClass =
  "absolute inset-x-0 bottom-0 h-auto max-h-[72%] min-h-[240px] w-full";

/* photoCredit accepts either a plain string or { text, href }. */
const credit =
  typeof hero.photoCredit === "string"
    ? { text: hero.photoCredit, href: null as string | null }
    : hero.photoCredit
      ? { text: hero.photoCredit.text, href: hero.photoCredit.href }
      : null;
---

<section id="top" class="relative overflow-hidden bg-ink-950 text-white">
  {/* ── Backdrop ───────────────────────────────────────────────────────── */}
  <div class="pointer-events-none absolute inset-0" aria-hidden={usePhoto ? "true" : null}>
    {
      usePhoto ? (
        <>
          {heroImage ? (
            <Picture
              src={heroImage}
              alt={hero.photoAlt}
              widths={[640, 960, 1280, 1920, 2400]}
              /* Caps the non-srcset <img> fallback, which would otherwise ship
                 the full-resolution original. */
              width={2400}
              sizes="100vw"
              formats={["webp"]}
              fallbackFormat="jpeg"
              quality={72}
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          ) : (
            /* Not in src/assets/hero — treat it as a path inside /public. */
            <img
              src={publicPhoto}
              alt={hero.photoAlt}
              class="absolute inset-0 h-full w-full object-cover object-center"
              fetchpriority="high"
            />
          )}
          {/* Scrim: darkens the photo enough for the headline to stay legible. */}
          <div
            class="absolute inset-0"
            style={`background:linear-gradient(to bottom,rgba(5,21,15,${hero.photoScrim + 0.12}) 0%,rgba(5,21,15,${hero.photoScrim}) 45%,rgba(5,21,15,0.94) 100%)`}
          />
        </>
      ) : (
        <SeoulSkyline class={skylineClass} />
      )
    }

    {/* Dusk glow over the city, in the continuum tier colours */}
    <div
      class="absolute -top-40 -left-32 h-[34rem] w-[34rem] rounded-full opacity-25 blur-3xl"
      style="background:radial-gradient(circle,var(--color-tier-edge),transparent 65%)"
    >
    </div>
    <div
      class="absolute -top-28 right-0 h-[32rem] w-[32rem] rounded-full opacity-25 blur-3xl"
      style="background:radial-gradient(circle,var(--color-tier-hpc),transparent 65%)"
    >
    </div>
    <div
      class="absolute right-1/4 bottom-1/3 h-72 w-[30rem] rounded-full opacity-20 blur-3xl"
      style="background:radial-gradient(circle,var(--color-urgent-500),transparent 70%)"
    >
    </div>

    {/* Settle the bottom edge into the next section */}
    <div
      class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-ink-950"
    >
    </div>
  </div>

  {/* ── Content ────────────────────────────────────────────────────────── */}
  <div class="relative mx-auto max-w-6xl px-6 pt-36 pb-24 sm:pt-44 sm:pb-32">
    <div data-reveal>
      <p
        class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-ink-950/40 px-4 py-1.5 text-sm backdrop-blur"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-urgent-500 opacity-75"
          ></span>
          <span
            class="relative inline-flex h-2 w-2 rounded-full bg-urgent-500"
          ></span>
        </span>
        <span class="font-medium text-white">
          A workshop at {site.conference.name}
        </span>
        <span class="text-ink-300">
          · {site.conference.city}, {site.conference.country}
        </span>
      </p>

      <h1
        class="mt-8 max-w-4xl text-4xl leading-[1.08] font-extrabold tracking-tight text-balance break-words drop-shadow-[0_2px_18px_rgba(5,21,15,0.85)] sm:text-5xl lg:text-6xl"
      >
        {site.title}
      </h1>

      <p
        class="mt-6 font-mono text-lg tracking-[0.2em] text-urgent-400 uppercase"
      >
        {site.abbr}
      </p>

      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200 text-pretty drop-shadow-[0_1px_12px_rgba(5,21,15,0.8)]"
      >
        {site.tagline}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={site.cta.primary.href}
          class="rounded-full bg-urgent-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-urgent-700"
        >
          {site.cta.primary.label}
        </a>
        <a
          href={site.cta.secondary.href}
          class="rounded-full border border-white/25 bg-ink-950/30 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-colors hover:bg-white/10"
        >
          {site.cta.secondary.label}
        </a>
      </div>
    </div>

    {/* Fact strip */}
    <dl
      class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:mt-24 lg:grid-cols-4"
      data-reveal
    >
      {
        site.facts.map((fact) => (
          <div class="bg-ink-950/70 px-5 py-5 backdrop-blur-md">
            <dt class="font-mono text-[0.7rem] tracking-[0.12em] text-ink-400 uppercase">
              {fact.label}
            </dt>
            <dd class="mt-2 font-semibold text-white">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  {
    usePhoto && credit && (
      <p
        class="absolute right-4 bottom-3 z-10 text-[0.7rem] text-white/45"
      >
        {credit.href ? (
          <a href={credit.href} class="hover:text-white/80">
            {credit.text}
          </a>
        ) : (
          credit.text
        )}
      </p>
    )
  }
</section>
