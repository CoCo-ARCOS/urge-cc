---
import { site } from "../site.config";
import logo from "../assets/logo/urge-cc-logo.svg";
import logoWhite from "../assets/logo/urge-cc-logo-white.svg";
---

<header
  id="site-header"
  {/* `at-top` is server-rendered so the header is legible over the dark hero
      on first paint; the scroll handler removes it once the page moves. */}
  class="at-top fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4"
    aria-label="Main"
  >
    <a href="#top" class="group flex items-center gap-3">
      {/* Two copies of the logo; CSS shows the one that suits the background. */}
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt={site.abbr}
        class="logo-on-light h-7 w-auto"
      />
      <img
        src={logoWhite.src}
        width={logoWhite.width}
        height={logoWhite.height}
        alt=""
        aria-hidden="true"
        class="logo-on-dark h-7 w-auto"
      />
      <span
        class="brand-sub hidden text-xs font-medium text-ink-500 sm:inline dark:text-ink-400"
      >
        {site.conference.name}
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav-link={item.id}
              class="nav-link rounded-full px-3 py-1.5 text-sm font-medium text-ink-600 transition-colors hover:bg-ink-100 hover:text-ink-900 aria-[current=true]:text-urgent-600 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white dark:aria-[current=true]:text-urgent-400"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="icon-btn rounded-full p-2 text-ink-600 transition-colors hover:bg-ink-100 hover:text-ink-900 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white"
      >
        <svg
          class="h-5 w-5 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="hidden h-5 w-5 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <a
        href={site.cta.primary.href}
        class="cta hidden rounded-full bg-ink-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-urgent-600 sm:inline-block dark:bg-white dark:text-ink-900 dark:hover:bg-urgent-600 dark:hover:text-white"
      >
        {site.cta.primary.label}
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="icon-btn rounded-full p-2 text-ink-600 hover:bg-ink-100 lg:hidden dark:text-ink-300 dark:hover:bg-ink-800"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-ink-100 bg-white/95 backdrop-blur lg:hidden dark:border-ink-800 dark:bg-ink-950/95"
  >
    <ul class="mx-auto max-w-6xl px-6 py-4">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink-700 hover:bg-ink-50 dark:text-ink-200 dark:hover:bg-ink-800"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={site.cta.primary.href}
          class="block rounded-lg bg-urgent-600 px-3 py-2.5 text-center text-base font-semibold text-white"
        >
          {site.cta.primary.label}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const menuToggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const themeToggle = document.getElementById("theme-toggle")!;

  /* Solidify the header once the page scrolls away from the hero. */
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    header.classList.toggle("bg-white/85", scrolled);
    header.classList.toggle("dark:bg-ink-950/85", scrolled);
    header.classList.toggle("backdrop-blur-md", scrolled);
    header.classList.toggle("border-ink-100", scrolled);
    header.classList.toggle("dark:border-ink-800", scrolled);
    header.classList.toggle("border-transparent", !scrolled);
    header.classList.toggle("at-top", !scrolled);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  /* Mobile menu. */
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  menuToggle.addEventListener("click", () => setMenu(menu.hidden));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });

  /* Theme toggle — persisted; the inline script in Layout applies it early. */
  themeToggle.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("urge-theme", dark ? "dark" : "light");
  });

  /* Highlight the nav link for whichever section is in view. */
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")].map(
      (a) => [a.dataset.navLink!, a],
    ),
  );
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute("aria-current");
        links.get(entry.target.id)?.setAttribute("aria-current", "true");
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  sections.forEach((s) => spy.observe(s));
</script>
