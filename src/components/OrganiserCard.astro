---
/**
 * One organiser: photo (or initials), name, affiliation, and email.
 *
 * Photos live in `src/assets/organisers/` and are named in site.config.ts.
 * Astro crops them to a square and emits WebP, so a large headshot is fine.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  person: {
    name: string;
    role?: string;
    affiliation: string;
    photo?: string;
    email?: string;
    url?: string;
  };
}

const { person } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/organisers/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const photo = person.photo
  ? photos[`/src/assets/organisers/${person.photo}`]?.default
  : undefined;

/* Fallback avatar: first and last initial, skipping titles and middle
   initials — "Dr. Dante D. Sanchez-Gallegos" gives DS, not DD. */
const nameParts = person.name
  .replace(/\b(Prof|Dr|Mr|Ms|Mrs)\.?\s*/gi, "")
  .split(/\s+/)
  .filter((part) => part && !/^[A-Z]\.?$/.test(part));

const initials = [nameParts.at(0), nameParts.at(-1)]
  .filter((part, i, all) => part && all.indexOf(part) === i)
  .map((part) => part![0].toUpperCase())
  .join("");

const hasLink = Boolean(person.url && person.url !== "#");
---

<li
  class="flex gap-5 rounded-2xl border border-ink-200 bg-white p-6 sm:gap-6 sm:p-7 dark:border-ink-800 dark:bg-ink-950"
  data-reveal
>
  <div class="shrink-0">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Portrait of ${person.name}`}
          width={224}
          height={224}
          quality={80}
          loading="lazy"
          class="h-20 w-20 rounded-full object-cover sm:h-24 sm:w-24"
        />
      ) : (
        <span
          class="flex h-20 w-20 items-center justify-center rounded-full bg-ink-100 font-mono text-xl font-semibold text-ink-400 sm:h-24 sm:w-24 dark:bg-ink-900 dark:text-ink-500"
          aria-hidden="true"
        >
          {initials}
        </span>
      )
    }
  </div>

  <div class="min-w-0 self-center">
    {
      person.role && (
        <p class="font-mono text-xs tracking-[0.12em] text-urgent-600 uppercase dark:text-urgent-400">
          {person.role}
        </p>
      )
    }

    <h3
      class:list={[
        "text-lg font-semibold text-ink-900 dark:text-white",
        person.role && "mt-2",
      ]}
    >
      {
        hasLink ? (
          <a
            href={person.url}
            class="underline decoration-ink-300 underline-offset-4 hover:decoration-urgent-500 dark:decoration-ink-600"
          >
            {person.name}
          </a>
        ) : (
          person.name
        )
      }
    </h3>

    <p class="mt-1 text-sm leading-relaxed text-ink-500 dark:text-ink-400">
      {person.affiliation}
    </p>

    {
      person.email && (
        <a
          href={`mailto:${person.email}`}
          class="mt-2 inline-block max-w-full truncate text-sm font-medium text-urgent-600 underline underline-offset-4 dark:text-urgent-400"
        >
          {person.email}
        </a>
      )
    }
  </div>
</li>
