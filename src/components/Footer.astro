---
import { site } from "../site.config";
import logoWhite from "../assets/logo/urge-cc-logo-white.svg";

const year = new Date().getFullYear();
---

{/* Always dark, in both themes — like the hero, it bookends the page. */}
<footer class="bg-ink-950 text-ink-300">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <img
          src={logoWhite.src}
          width={logoWhite.width}
          height={logoWhite.height}
          alt={site.abbr}
          class="h-8 w-auto"
        />
        <p class="mt-3 text-sm leading-relaxed text-ink-400">
          {site.title}
        </p>
        <a
          href={`mailto:${site.contact.email}`}
          class="mt-4 inline-block text-sm font-medium text-urgent-400 underline underline-offset-4 hover:text-urgent-300"
        >
          {site.contact.email}
        </a>
      </div>

      <div class="flex gap-14">
        <nav aria-label="Footer">
          <p class="font-mono text-xs tracking-[0.12em] text-ink-500 uppercase">
            Workshop
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="text-sm text-ink-300 hover:text-urgent-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <p class="font-mono text-xs tracking-[0.12em] text-ink-500 uppercase">
            Elsewhere
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              site.contact.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-300 hover:text-urgent-400"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-12 border-t border-white/10 pt-6 text-sm text-ink-400">
      &copy; {year} {site.abbr} · Held with {site.conference.name}, {
        site.conference.city
      }, {site.conference.country}.
    </p>
  </div>
</footer>
